<Window
    x:Class="Forge.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Forge.App.Views"
    xmlns:vm="clr-namespace:Forge.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Title="Forge"
    Icon="/Assets/app.ico"
    Width="1280" Height="800" MinWidth="720" MinHeight="420"
    Background="{DynamicResource Forge.WindowBrush}"
    Foreground="{DynamicResource Forge.TextBrush}"
    FontFamily="{DynamicResource Forge.FontUi}"
    FontSize="13">

    <!-- Barra de título própria (36 px): o conteúdo vai até o topo e os botões da janela são desenhados aqui. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" BorderThickness="1" BorderBrush="{DynamicResource Forge.LineBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Border Grid.Row="0" Background="{DynamicResource Forge.ChromeBrush}" BorderBrush="{DynamicResource Forge.LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock Text="Forge" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" Padding="8,0" Height="22" CornerRadius="11" Background="{DynamicResource Forge.AdminSoftBrush}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Shield24" Filled="True" FontSize="12" Foreground="{DynamicResource Forge.AdminBrush}" />
                                <TextBlock Text="Administrador" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Forge.AdminBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Forge.TextMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1" Width="280" Height="26" Command="{Binding OpenHistoryCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Buscar no histórico (Ctrl+R)"
                            Style="{StaticResource Forge.SecondaryButton}" Background="{DynamicResource Forge.WindowBrush}" Padding="10,0">
                        <DockPanel Width="256" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+R" FontSize="11" Foreground="{DynamicResource Forge.TextMutedBrush}" />
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Search24" FontSize="13" Foreground="{DynamicResource Forge.TextSecondaryBrush}" />
                            <TextBlock Text="Buscar no histórico…" Margin="8,0" FontSize="12" Foreground="{DynamicResource Forge.TextSecondaryBrush}" />
                        </DockPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Forge.IconButton}" Command="{Binding OpenSettingsCommand}" Height="28" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Configurações (Ctrl+,)" AutomationProperties.Name="Configurações">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                        </Button>
                        <Button Width="46" Style="{StaticResource Forge.IconButton}" Height="36" Click="OnMinimize"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimizar">
                            <ui:SymbolIcon Symbol="Subtract24" FontSize="12" />
                        </Button>
                        <Button Width="46" Style="{StaticResource Forge.IconButton}" Height="36" Click="OnMaximize"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximizar">
                            <ui:SymbolIcon Symbol="Maximize24" FontSize="12" />
                        </Button>
                        <Button Width="46" Style="{StaticResource Forge.IconButton}" Height="36" Click="OnClose"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Fechar">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Barra lateral + área da aba -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:Sidebar Grid.Column="0" />

                <DockPanel Grid.Column="1" x:Name="TabArea">
                    <views:TabHeader DockPanel.Dock="Top" />
                    <views:TabConfigPanel DockPanel.Dock="Top" DataContext="{Binding SelectedTab}"
                                          Visibility="{Binding IsConfigOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    <views:TerminalArea x:Name="Terminals" />
                </DockPanel>
            </Grid>

            <views:StatusBar Grid.Row="2" x:Name="Status" />

            <!-- Popups ficam por cima do terminal nativo (que é uma janela Win32 e cobriria qualquer elemento WPF). -->
            <Popup x:Name="HistoryPopup" Grid.Row="1" PlacementTarget="{Binding ElementName=TabArea}" Placement="Center"
                   IsOpen="{Binding History.IsOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" Opened="OnHistoryOpened">
                <views:HistoryPopup x:Name="HistoryView" DataContext="{Binding History}" />
            </Popup>

            <Popup x:Name="ToastPopup" PlacementTarget="{Binding ElementName=Status}" Placement="Custom"
                   IsOpen="{Binding Notifier.IsVisible, Mode=OneWay}" StaysOpen="True" AllowsTransparency="True">
                <Border Width="360" Padding="14,12" CornerRadius="10" Background="{DynamicResource Forge.RaisedBrush}"
                        BorderBrush="{DynamicResource Forge.StrongLineBrush}" BorderThickness="1" DataContext="{Binding Notifier}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Forge.SmallIconButton}" Command="{Binding DismissCommand}"
                                VerticalAlignment="Top" ToolTip="Fechar" AutomationProperties.Name="Fechar aviso">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                        </Button>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Forge.TextSecondaryBrush}"
                                       Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
