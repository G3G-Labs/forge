<Window
    x:Class="Forge.App.Views.GroupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Forge.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:GroupEditorViewModel}"
    Title="{Binding Title}" Width="460" SizeToContent="Height"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
    Style="{StaticResource Forge.DialogWindow}">

    <!-- O grupo só organiza abas, como no Warp: nome e cor. O tipo e a pasta são de cada aba. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <!-- O X da barra de título (ApplicationCommands.Close) desiste, como o Esc. -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnCloseExecuted" />
    </Window.CommandBindings>

    <StackPanel Margin="24,18,24,20">
        <!-- Prévia: como o grupo vai aparecer na barra lateral -->
        <Border Margin="0,0,0,18" Padding="12,10" CornerRadius="8" Background="{DynamicResource Forge.RaisedBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="4" VerticalAlignment="Top" Margin="0,3,10,0"
                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                <StackPanel>
                    <TextBlock Text="{Binding PreviewName}" FontWeight="SemiBold" />
                    <TextBlock Text="Abas: use o + do grupo para abrir PowerShell, CMD, Git Bash ou WSL." Margin="0,2,0,0" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource Forge.TextMutedBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Text="Nome" Style="{StaticResource Forge.FieldLabel}" />
        <TextBox x:Name="NameBox" Style="{StaticResource Forge.Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Nome do grupo" />

        <TextBlock Text="Cor" Margin="0,16,0,6" Style="{StaticResource Forge.FieldLabel}" />
        <ItemsControl ItemsSource="{Binding Colors}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ColorOption}">
                    <Button Width="32" Height="32" Margin="0,0,6,6" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Ring" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                                    <Border CornerRadius="6" Background="{Binding Hex, Converter={StaticResource HexToBrush}}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Forge.TextBrush}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBox Width="110" Style="{StaticResource Forge.MonoInput}" Text="{Binding CustomHex, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Qualquer cor: #RRGGBB ou #RGB" AutomationProperties.Name="Cor personalizada" />
            <TextBlock Text="cor personalizada (#RRGGBB)" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource Forge.TextMutedBrush}" />
        </StackPanel>

        <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Forge.SecondaryButton}" Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Forge.PrimaryButton}" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
