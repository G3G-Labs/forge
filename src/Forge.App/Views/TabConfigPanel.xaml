<UserControl
    x:Class="Forge.App.Views.TabConfigPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Forge.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:TabViewModel}">

    <!-- Configurar aba: no lugar, entre o cabeçalho e o terminal. Cada campo salva ao mudar. -->
    <Border Background="{DynamicResource Forge.ChromeBrush}" BorderBrush="{DynamicResource Forge.LineBrush}" BorderThickness="0,0,0,1" Padding="24,18">
        <Grid DataContext="{Binding Config}" d:DataContext="{d:DesignInstance Type=vm:TabConfigViewModel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Forge.IconButton}" Width="28" Height="28" Command="{Binding CloseCommand}"
                        ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar configuração">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="Alterações salvas automaticamente" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Forge.TextMutedBrush}" />
                <TextBlock Text="Configurar aba" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                <TextBlock Text="Shell" Style="{StaticResource Forge.FieldLabel}" />
                <ComboBox ItemsSource="{Binding Shells}" SelectedItem="{Binding Shell}" DisplayMemberPath="Name" Height="32" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                <TextBlock Text="Pasta inicial" Style="{StaticResource Forge.FieldLabel}" />
                <TextBox Style="{StaticResource Forge.MonoInput}" Text="{Binding Cwd, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.Name="Pasta inicial" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                <TextBlock Text="Comando de inicialização" Style="{StaticResource Forge.FieldLabel}" />
                <TextBox Style="{StaticResource Forge.MonoInput}" Text="{Binding Startup, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.Name="Comando de inicialização" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Forge.Hint}"
                           Text="Roda pelo botão Iniciar, ou sozinho ao abrir o app se a chave ao lado estiver ligada." />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                <ui:ToggleSwitch IsChecked="{Binding Autostart}" Content="Iniciar automaticamente" Margin="0,22,0,0" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Forge.Hint}"
                           Text="Executa o comando quando o app abre, mesmo sem a aba estar visível." />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0">
                <TextBlock Text="Variáveis de ambiente (opcional)" Style="{StaticResource Forge.FieldLabel}" />
                <ItemsControl ItemsSource="{Binding Env}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EnvVarViewModel}">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Forge.IconButton}" Width="28" Height="28" Command="{Binding RemoveCommand}"
                                        ToolTip="Remover" AutomationProperties.Name="Remover variável">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                </Button>
                                <TextBox DockPanel.Dock="Left" Width="140" Style="{StaticResource Forge.MonoInput}" Height="30"
                                         Text="{Binding Key, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Nome da variável" />
                                <TextBlock DockPanel.Dock="Left" Text="=" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource Forge.TextMutedBrush}" />
                                <TextBox Style="{StaticResource Forge.MonoInput}" Height="30" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="Valor da variável" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Forge.IconButton}" Width="Auto" Height="28" Padding="8,0" HorizontalAlignment="Left"
                        Command="{Binding AddEnvCommand}" Foreground="{DynamicResource Forge.AccentBrush}">
                    <StackPanel Orientation="Horizontal" Margin="8,0">
                        <ui:SymbolIcon Symbol="Add24" FontSize="12" />
                        <TextBlock Text="Adicionar variável" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Forge.Hint}" Text="Aplicadas pelo script da aba, inclusive em abas WSL." />
            </StackPanel>

            <Border Grid.Row="3" Grid.Column="2" VerticalAlignment="Top" Padding="12,10" CornerRadius="8" Background="{DynamicResource Forge.RaisedBrush}"
                    Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Forge.SecondaryButton}" Height="28" Content="Reiniciar agora"
                            Command="{Binding RestartNowCommand}" />
                    <TextBlock Text="Shell, pasta e variáveis valem no próximo início." FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
