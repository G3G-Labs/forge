<UserControl
    x:Class="Forge.App.Views.TabConfigPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Forge.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:TabViewModel}">

    <!-- Configurar aba: no lugar, entre o cabeçalho e o terminal. Cada campo salva ao mudar. -->
    <Border Background="{DynamicResource Forge.ChromeBrush}" BorderBrush="{DynamicResource Forge.LineBrush}" BorderThickness="0,0,0,1" Padding="24,18">
        <Grid DataContext="{Binding Config}" d:DataContext="{d:DesignInstance Type=vm:TabConfigViewModel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Forge.IconButton}" Width="28" Height="28" Command="{Binding CloseCommand}"
                        ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar configuração">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="Alterações salvas automaticamente" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Forge.TextMutedBrush}" />
                <!-- Prévia: a aba como aparece na barra lateral -->
                <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="3" Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{Binding PreviewColor, Converter={StaticResource HexToBrush}}" />
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Nome e cor -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                <TextBlock Text="Nome" Style="{StaticResource Forge.FieldLabel}" />
                <TextBox Style="{StaticResource Forge.Input}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Nome da aba" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                <TextBlock Text="Cor" Style="{StaticResource Forge.FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <Button Height="30" Padding="10,0" Margin="0,0,8,0" Command="{Binding UseGroupColorCommand}" Content="Do grupo"
                            ToolTip="Usar a cor do grupo">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Forge.SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsesGroupColor}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Forge.TextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Colors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ColorOption}">
                                <Button Width="30" Height="30" Margin="0,0,6,0" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Cursor="Hand"
                                        Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                                                <Border CornerRadius="5" Background="{Binding Hex, Converter={StaticResource HexToBrush}}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Forge.TextBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Onde a aba roda -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                <TextBlock Text="Shell" Style="{StaticResource Forge.FieldLabel}" />
                <ComboBox ItemsSource="{Binding ShellChoices}" SelectedItem="{Binding ShellChoice}" DisplayMemberPath="Label" Height="32"
                          AutomationProperties.Name="Shell da aba" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                <TextBlock Text="Pasta" Style="{StaticResource Forge.FieldLabel}" />
                <Grid>
                    <TextBox x:Name="CwdBox" Style="{StaticResource Forge.MonoInput}" Text="{Binding Cwd, UpdateSourceTrigger=LostFocus}"
                             AutomationProperties.Name="Pasta da aba" />
                    <TextBlock Text="{Binding FolderPlaceholder}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               FontFamily="{DynamicResource Forge.FontMono}" FontSize="12" Foreground="{DynamicResource Forge.TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Text, ElementName=CwdBox, Converter={StaticResource InverseNullToVisibility}}" />
                </Grid>
            </StackPanel>

            <!-- Comando ao abrir: opcional, escrito pelo usuário -->
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                <TextBlock Text="Comando ao abrir (opcional)" Style="{StaticResource Forge.FieldLabel}" />
                <TextBox Style="{StaticResource Forge.MonoInput}" Text="{Binding Startup, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.Name="Comando ao abrir" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Forge.Hint}"
                           Text="Ex.: bun dev, yarn dev, npm run dev. Roda sempre que o shell desta aba abre; vazio, a aba só abre o shell na pasta." />
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                <ui:ToggleSwitch IsChecked="{Binding Autostart}" Content="Abrir junto com o app" Margin="0,22,0,0" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Forge.Hint}"
                           Text="Ligado, a aba abre (e roda o comando, se houver) quando o Forge abre. Desligado, só quando você clicar nela." />
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0">
                <TextBlock Text="Variáveis de ambiente (opcional)" Style="{StaticResource Forge.FieldLabel}" />
                <ItemsControl ItemsSource="{Binding Env}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EnvVarViewModel}">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Forge.IconButton}" Width="28" Height="28" Command="{Binding RemoveCommand}"
                                        ToolTip="Remover" AutomationProperties.Name="Remover variável">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                </Button>
                                <TextBox DockPanel.Dock="Left" Width="140" Style="{StaticResource Forge.MonoInput}" Height="30"
                                         Text="{Binding Key, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Nome da variável" />
                                <TextBlock DockPanel.Dock="Left" Text="=" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource Forge.TextMutedBrush}" />
                                <TextBox Style="{StaticResource Forge.MonoInput}" Height="30" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="Valor da variável" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Forge.IconButton}" Width="Auto" Height="28" HorizontalAlignment="Left"
                        Command="{Binding AddEnvCommand}" Foreground="{DynamicResource Forge.AccentBrush}">
                    <StackPanel Orientation="Horizontal" Margin="8,0">
                        <ui:SymbolIcon Symbol="Add24" FontSize="12" />
                        <TextBlock Text="Adicionar variável" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Row="4" Grid.Column="2" VerticalAlignment="Top" Padding="12,10" CornerRadius="8" Background="{DynamicResource Forge.RaisedBrush}"
                    Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Forge.SecondaryButton}" Height="28" Content="Reiniciar shell agora"
                            Command="{Binding RestartNowCommand}" />
                    <TextBlock Text="Shell, pasta e variáveis valem quando o shell reabre." FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
