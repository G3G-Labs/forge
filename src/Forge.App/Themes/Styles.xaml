<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Botão só de ícone (32 px): cabeçalho da aba, barra lateral. Todo ícone tem ToolTip com o atalho. -->
    <Style x:Key="Forge.IconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Forge.SelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Forge.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Forge.TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Forge.SmallIconButton" TargetType="Button" BasedOn="{StaticResource Forge.IconButton}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- Ação principal (Iniciar, Reiniciar, Criar): fundo no acento. -->
    <Style x:Key="Forge.PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.OnAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource Forge.AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Forge.SecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Forge.RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forge.StrongLineBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Forge.SelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linha clicável da barra lateral (grupo ou aba): sem borda, destaque no hover e quando selecionada. -->
    <Style x:Key="Forge.RowButton" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource Forge.RowHeight}" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Forge.RaisedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Forge.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.TextMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Forge.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Forge.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.TextMutedBrush}" />
    </Style>

    <Style x:Key="Forge.Input" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Forge.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource Forge.InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Forge.StrongLineBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Forge.TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Forge.AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Forge.MonoInput" TargetType="TextBox" BasedOn="{StaticResource Forge.Input}">
        <Setter Property="FontFamily" Value="{DynamicResource Forge.FontMono}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Pílula de estado no cabeçalho da aba: verde rodando, vermelho erro, neutra parada. -->
    <Style x:Key="Forge.StatePill" TargetType="Border">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{DynamicResource Forge.SelectedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Forge.TextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Running">
                <Setter Property="Background" Value="{DynamicResource Forge.RunningSoftBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Forge.RunningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
                <Setter Property="Background" Value="{DynamicResource Forge.ErrorSoftBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Forge.ErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
