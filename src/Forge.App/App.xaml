<Application
    x:Class="Forge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:Forge.App.Converters"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- O índice 2 é trocado pelo Tokens.Light.xaml no tema claro (App.ApplyChromeTheme). -->
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:HexToGuideBrushConverter x:Key="HexToGuideBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullToVisibilityConverter x:Key="InverseNullToVisibility" Invert="True" />
            <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />

            <!--
                Cabeçalho do item do submenu de cor (aba e grupo), gerado da paleta (ColorMenuItem): amostra + nome. O estilo
                do item (Forge.ColorMenuItem) é montado no App.OnStartup, por cima do estilo de MenuItem do WPF-UI.
            -->
            <DataTemplate x:Key="Forge.ColorMenuHeader">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="12" Margin="0,0,10,0" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{DynamicResource Forge.StrongLineBrush}" BorderThickness="1" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
